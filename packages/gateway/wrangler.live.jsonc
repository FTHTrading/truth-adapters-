// LIVE config. Same Worker name, same routes, same D1 as wrangler.jsonc. Only the rail vars differ.
//   go live:      npx wrangler deploy -c wrangler.live.jsonc
//   back to test: npx wrangler deploy                      (wrangler.jsonc)
// Requires two Worker secrets first (config.ts refuses paid routes without them):
//   npx wrangler secret put CDP_API_KEY_ID     --name genesis402-apex
//   npx wrangler secret put CDP_API_KEY_SECRET --name genesis402-apex
{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "genesis402-apex",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 * * * *"] },
  "workers_dev": false,
  "routes": [
    { "pattern": "genesis402.com/*", "zone_name": "genesis402.com" },
    { "pattern": "www.genesis402.com/*", "zone_name": "genesis402.com" },
    { "pattern": "troptionsmint.com/*", "zone_name": "troptionsmint.com" },
    { "pattern": "www.troptionsmint.com/*", "zone_name": "troptionsmint.com" }
  ],
  "ratelimits": [{ "name": "FREE_READS", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "LEDGER",
      "database_name": "truth-ledger-v1",
      "database_id": "4b03924c-0b42-40f3-9898-61511ccba7ce"
    }
  ],
  "vars": {
    "SERVICE_NAME": "genesis402-truth-gateway",
    // Base mainnet. With no X402_FACILITATOR_URL the gateway selects the CDP facilitator when the two secrets exist.
    "X402_NETWORK": "base",
    "X402_PAY_TO": "0x7d9a65d06dcc435a52D5880C6310Bd6E96c156DB",
    "X402_MAX_TIMEOUT_SECONDS": "60",
    "APOSTLE_FACILITATOR_URL": "https://x402.unykorn.org",
    "APOSTLE_PRICE_ATP_RAW": "250000000000000000",
    "SECURITY_CONTACT": "mailto:kevan@unykorn.org"
  }
}
