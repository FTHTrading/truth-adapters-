# Gateway secrets (set with `wrangler secret put`, never committed)
# WITNESS_PRIVATE_KEY_JWK={"kty":"OKP","crv":"Ed25519","x":"...","d":"..."}

# MCP / agent client (local env only, never committed)
# X402_PAYER_PRIVATE_KEY=0x...          # EVM key holding USDC on the configured network
# X402_MAX_ATOMIC=100000               # refuse any single payment above this (USDC 6dp; 100000 = $0.10)
# TRUTH_WITNESS_JWK={"kty":"OKP",...}   # local witness key for truth_witness_local; ephemeral if unset
# TRUTH_GATEWAY_URL=http://127.0.0.1:8787
